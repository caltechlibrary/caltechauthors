[Unit]
Description=Launch InvenioRDM Celery Task

[Service]
Type=simple
User=tmorrell
StandardOutput=kmsg
StandardError=kmsg
WorkingDirectory=/Sites/caltechauthors
EnvironmentFile=/Sites/caltechauthors/.env
ExecStart=/usr/local/bin/uv run celery --app invenio_app.celery worker --beat --events --loglevel INFO

[Install]
WantedBy=multi-user.target
