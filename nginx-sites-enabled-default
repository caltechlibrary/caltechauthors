include redirect-map.conf;

server {

  server_name authors.library.caltech.edu

  add_header Strict-Transport-Security "max-age=15768000"; # 6 months

  # Request ID tracing (allows end-to-end tracking of requests for better
  # troubleshooting)
  add_header X-Request-ID $request_id;

  # The request body is sent to the proxied server immediately as it is
  # received
  proxy_request_buffering off;
  # Sets the HTTP protocol v1.1 for proxying in order to not use the buffer
  # in case of chunked transfer encoding
  proxy_http_version 1.1;

  # Proxying to the application server (Granian, plain HTTP/WSGI -- no
  # more uwsgi_pass/uwsgi_params, this is a standard reverse proxy now)
  ## UI server
  location / {
    proxy_pass http://127.0.0.1:5000;
    proxy_buffering off;
    proxy_request_buffering off;
    chunked_transfer_encoding off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Pass request id to the ui server
    proxy_set_header X-Request-ID $request_id;
    # X-Session-ID / X-User-ID is read by nginx and included in the logs,
    # however we don't want to expose them to clients so we are hiding them.
    proxy_hide_header X-Session-ID;
    proxy_hide_header X-User-ID;
    # Max upload size (except for files) is set to 100mb as default.
    client_max_body_size 100m;
  }
  ## Most API
  # NOTE: proxy_pass has a trailing slash here deliberately -- Granian's
  # invenio_app.wsgi_rest:application mounts blueprints at the root, not
  # under /api, so nginx must strip the /api prefix itself (a trailing
  # slash on proxy_pass replaces the matched location prefix instead of
  # preserving the full path; without it every /api/* request 404s).
  location /api {
    proxy_pass http://127.0.0.1:5001/;
    proxy_buffering off;
    proxy_request_buffering off;
    chunked_transfer_encoding off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Pass request id to the api server
    proxy_set_header X-Request-ID $request_id;
    # X-Session-ID / X-User-ID is read by nginx and included in the logs,
    # however we don't want to expose them to clients so we are hiding them.
    proxy_hide_header X-Session-ID;
    proxy_hide_header X-User-ID;
    # Max upload size (except for files) is set to 100mb as default.
    client_max_body_size 100m;
  }
  ## API files
  # Another location is defined in order to allow large file uploads in the files
  # API without exposing the other parts of the application to receive huge
  # request bodies.
  # Regex locations can't use proxy_pass's trailing-slash prefix-strip
  # trick above, so the /api/ prefix is dropped explicitly via a capture
  # group instead. The optional trailing /<part-number> and trailing
  # slash preserve what the original uwsgi_pass regex (and the
  # docker/nginx Compose variant) both allowed -- multipart file content
  # requests carry a numeric part suffix.
  location ~ ^/api/(records/.+/draft/files/.+/content(?:/[0-9]+)?/?)$ {
    gzip off;
    proxy_pass http://127.0.0.1:5001/$1;
    proxy_buffering off;
    chunked_transfer_encoding off;
    proxy_request_buffering off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Pass request id to api server
    proxy_set_header X-Request-ID $request_id;
    # X-Session-ID / X-User-ID is read by nginx and included in the logs,
    # however we don't want to expose them to clients so we are hiding them.
    proxy_hide_header X-Session-ID;
    proxy_hide_header X-User-ID;
    # Max upload size for files is set to 500GB (configure as needed).
    client_max_body_size 500G;
  }
  # Static content is served directly by nginx and not the application server.
  # Path updated for the uv migration -- uv puts the venv (and therefore
  # INSTANCE_PATH) at <repo>/.venv, not the old Pipenv virtualenvs dir.
   location /static {
    alias /Sites/caltechauthors/.venv/var/instance/static;
    autoindex off;
  }
  #Redirect old urls from redirect-map
  if ( $redirect_uri ) {
        return 301 $redirect_uri;
    }



    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/authors.library.caltech.edu/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/authors.library.caltech.edu/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}



server {
    if ($host = authors.library.caltech.edu) {
        return 301 https://$host$request_uri;
    } # managed by Certbot



  server_name authors.library.caltech.edu

  add_header Strict-Transport-Security "max-age=15768000";
    listen 80;
    return 404; # managed by Certbot


}
